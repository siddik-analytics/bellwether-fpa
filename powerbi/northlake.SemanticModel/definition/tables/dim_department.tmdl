table dim_department

	column 'Department key'
		dataType: int64
		summarizeBy: none
		sourceColumn: department_key
		lineageTag: dim_department-department_key

	column 'Department'
		dataType: string
		summarizeBy: none
		sourceColumn: department_name
		lineageTag: dim_department-department_name

	column 'Is corporate'
		dataType: boolean
		summarizeBy: sum
		sourceColumn: is_corporate
		lineageTag: dim_department-is_corporate

	partition dim_department = m
		mode: import
		source = let Source = Parquet.Document(File.Contents(Text.Combine({ProjectRoot, "data/star/dim_department.parquet"}))) in Source
