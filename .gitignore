# Generated data and build artifacts — never committed outside a release tag.
# Anchored to the repo root: unanchored, `data/` also matches src/bellwether/data/ and
# silently excludes the generator package from every commit.
/data/
/build/

# Excel
*.xlsx
*.xlsm
*.xlsb
*.xls

# Office lock files. Generalised rather than listed per extension: these appear the moment
# a document is opened, under whatever extension, and one of them reaching a commit is the
# kind of mistake that is permanent in a public repo.
~$*

# Power BI — PBIP text format is committed; the binary is not
*.pbix
*.pbit
.pbi/
**/.pbi/localSettings.json
**/*.abf

# Office / PDF outputs
*.pdf
*.docx
*.pptx

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/

# Claude Code — project settings are shared, local ones are not
.claude/settings.local.json

# OS / editor
Thumbs.db
desktop.ini
.vscode/
.idea/

# Secrets
.env
.env.*

# Power BI Desktop's working files, written whenever the generated project is opened.
# .pbi/ holds a DPAPI-encrypted securityBindingsSignature (machine-bound credential material)
# and cache.abf (a binary). Neither belongs in a repository strangers clone.
powerbi/**/.pbi/
powerbi/**/StaticResources/
powerbi/**/*.abf
